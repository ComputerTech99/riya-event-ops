# true (default) = realistic in-memory mock feed. false = live Firestore listeners.
EXPO_PUBLIC_USE_MOCK=true

# Firebase web app config (Project settings > Your apps > Web app)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=riya-event-ops-485f
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# HTTPS function hit by "Call now" and "Retry". Defaults to asia-south1 placeCall.
# EXPO_PUBLIC_PLACE_CALL_URL=https://asia-south1-riya-event-ops-485f.cloudfunctions.net/placeCall
EXPO_PUBLIC_SEAT_CAPACITY=40
EXPO_PUBLIC_EVENT_NAME=HACK2026
