{
  "name": "riya-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "deploy": "firebase deploy --only functions,firestore",
    "test:emulator": "cd .. && firebase emulators:exec --only firestore --project demo-riya \"cd functions && npx tsx test/integration.emulator.ts\"",
    "event": "tsx scripts/admin.ts event",
    "import": "tsx scripts/admin.ts import",
    "launch": "tsx scripts/admin.ts launch",
    "dialer": "tsx scripts/admin.ts dialer"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}